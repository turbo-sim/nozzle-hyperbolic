    fluid_name: Air
    use_lookup_table: True
    lut: 
        backend: HEOS
        h_min: 100000.0
        h_max: 500000.0
        p_min: 1000.0
        p_max: 500000.0
        N_h: 100
        N_p: 60
        table_dir: fluid_tables
