boundary_conditions: 
    p_stagnation: 1.0e5
    T_stagnation: 348.0
    p_out: 1.0e4
numerical_settings: 
    Nx: 50
    x1: 0.0
    x2: 1.0
    t1: 0.0
    t2: 0.00054
    CFL: 0.01
    max_iterations: 10000
    residuals: 1e-08
    flux_method: hllc
    time_discretization: euler
    reconstruction: constant
nozzle_parameters: 
    type: shock_tube
    area: 1.0
    roughness: 0.0
