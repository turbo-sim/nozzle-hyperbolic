boundary_conditions: 
    p_stagnation: 1.0e5
    T_stagnation: 348.0
    p_out: 1.0e4
numerical_settings: 
    Nx: 800
    x1: 0.0
    x2: 1.0
    t1: 0.0
    t2: 0.00054
    CFL: 0.3
    max_iterations: 10000
    residuals: 1e-08
    flux_method: hllc
    time_discretization: euler
    reconstruction: constant
nozzle_parameters: 
    type: shock_tube
    area: 1.0
    roughness: 0.0
    shock_tube: 
        x_diaphragm: 0.5
        p_L: 1.0e5
        T_L: 348.0
        u_L: 1e-06
        p_R: 1.0e4
        T_R: 278.0
        u_R: 1e-06
fluid: 
    perfect_gas: False
    fluid_name: Air
    use_lookup_table: True
    lut: 
        backend: HEOS
        h_min: 100000.0
        h_max: 500000.0
        p_min: 1000.0
        p_max: 500000.0
        N_h: 100
        N_p: 60
        table_dir: fluid_tables
