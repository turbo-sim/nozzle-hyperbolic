# Fluid property tables (large binary files — regenerated on first run)
*.pkl
*.npz
fluid_tables/

# Compiled Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Test and analysis caches
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.tox/
.nox/

# Coverage output (keep .coveragerc trackable)
.coverage
.coverage.*
htmlcov/
coverage.xml
/test-results/

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Generated documentation
/docs/_build/

# OS artefacts
Thumbs.db
.DS_Store
*.db

# Archives
*.zip

# IDE
.vscode/
.idea/

# JAX
.jax_cache/

# HPC
*.out
*.err

# Private environment files; keep shareable examples and templates
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Generated result/output directories at any depth (directory names by prefix)
results*/
output*/

# old_file
old_*

implementation_notes/
demo_nozzlex/

