{
  "schema_version": 1,
  "profile": "implicit_backtracking_grid_sequence",
  "fluid_cases": [
    "supercritical",
    "lettieri_equilibrium"
  ],
  "regimes": [
    "adapted",
    "shock"
  ],
  "fluxes": [
    "rusanov",
    "hll",
    "roe",
    "stadtke",
    "osher_gauss",
    "osher_partitioned"
  ],
  "reconstructions": [
    "constant",
    "muscl_van_leer"
  ],
  "grids": [
    50,
    100,
    200,
    400,
    800
  ],
  "cold_start": {
    "adapted": "table_mach_ramp",
    "inlet_velocity_over_a0": 0.02,
    "outlet_mach_table": 1.5,
    "shock": "production_default"
  },
  "table_overrides": {
    "supercritical": {
      "name": "co2_supercritical_fvm_100x100",
      "p_max": 60000000.0
    },
    "lettieri_equilibrium": {
      "name": "co2_lettieri_fvm_100x100",
      "p_max": 18000000.0
    }
  },
  "scheme": {
    "time_integrator": "euler-implicit",
    "boundary_treatment": "coupled",
    "newton_iterations": 10,
    "newton_backtracking": true,
    "newton_update_tolerance": 1e-10,
    "newton_residual_tolerance": 1e-12,
    "max_backtracks": 20,
    "jacobian_mode": "colored",
    "linear_solver": "banded",
    "delta_factor": 0.1,
    "filter_strength": 0.0
  },
  "steady": {
    "cfl": 0.2,
    "cfl_growth": 1.2,
    "cfl_max": 1000000.0,
    "cfl_shrink": 0.5,
    "max_steps": 16000,
    "max_retries": 14,
    "stagnation_steps": 64
  },
  "residual": {
    "norm": "l2",
    "weighting": "volume",
    "criterion": "either",
    "relative_tolerance": 1e-06,
    "absolute_tolerance": 1e-09,
    "boundary_tolerance": 1e-09,
    "global_tolerance": 1e-09,
    "initial_floor": 1e-14
  },
  "flux_options": {
    "stadtke": {
      "flux": "stadtke",
      "custom_jump_correction": true,
      "custom_endpoint_envelope": true
    },
    "osher_gauss": {
      "flux": "osher",
      "quadrature_points": 5,
      "integration": "gauss"
    },
    "osher_partitioned": {
      "flux": "osher",
      "quadrature_points": 5,
      "integration": "sonic_partitioned"
    }
  },
  "execution_limits": {
    "default_wall_seconds": 180.0,
    "osher_wall_seconds": 600.0
  }
}
