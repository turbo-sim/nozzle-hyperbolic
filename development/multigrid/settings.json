{
  "schema_version": 1,
  "cases": ["subsonic", "shock_30", "shock_70", "adapted"],
  "reconstructions": ["constant", "muscl_van_leer"],
  "grids": [50, 100, 200, 400],
  "methods": ["sequence", "fas_implicit", "fas_explicit"],
  "repeats": 10,
  "scheme": {
    "flux": "hll", "time_integrator": "euler-implicit", "boundary_treatment": "coupled",
    "newton_iterations": 10, "newton_backtracking": true,
    "newton_update_tolerance": 1e-10, "newton_residual_tolerance": 1e-12,
    "jacobian_mode": "colored", "linear_solver": "banded", "filter_strength": 0.0
  },
  "residual": {
    "norm": "l2", "weighting": "volume", "criterion": "absolute",
    "absolute_tolerance": 1e-9, "relative_tolerance": 1e-6,
    "boundary_tolerance": 1e-9, "global_tolerance": 1e-9,
    "constraint_tolerance": 1e-9, "initial_floor": 1e-14
  },
  "steady": {
    "cfl": 0.2, "cfl_growth": 1.2, "cfl_max": 1000000.0,
    "max_steps": 16000, "max_retries": 14, "stagnation_steps": 64
  },
  "fas": {
    "cfl": 0.2, "cfl_growth": 1.5, "cfl_max": 1000000.0,
    "max_cycles": 300, "max_wall_s": 120.0,
    "pre_sweeps": 1, "post_sweeps": 1, "coarse_steps": 4,
    "max_retries": 10, "correction_backtracks": 12,
    "correction_damping": 1.0, "min_damping": 0.000244140625
  },
  "method_settings": {
    "fas_explicit": {"pre_sweeps": 2, "post_sweeps": 2}
  },
  "comparison_field_tolerance": 1e-6
}
