{
  "schema_version": 1,
  "cases": [
    "nozzle_shock35", "nozzle_shock70", "annular_shock35", "annular_shock70",
    "supercritical_shock", "lettieri_equilibrium_shock"
  ],
  "outlets": ["acoustic", "finite_wave"],
  "starts": ["stagnant", "adapted"],
  "fluxes": ["hll", "stadtke"],
  "reconstructions": ["constant", "muscl_van_leer"],
  "grids": [50, 100, 200],
  "adapted_seed_cells": 50,
  "scheme": {
    "time_integrator": "euler-implicit",
    "boundary_treatment": "coupled",
    "newton_iterations": 10,
    "newton_backtracking": true,
    "newton_update_tolerance": 1e-10,
    "newton_residual_tolerance": 1e-12,
    "max_backtracks": 20,
    "jacobian_mode": "colored",
    "linear_solver": "banded",
    "delta_factor": 0.1,
    "filter_strength": 0.0,
    "custom_jump_correction": true,
    "custom_endpoint_envelope": true
  },
  "steady": {
    "cfl": 0.2, "cfl_growth": 1.2, "cfl_max": 1000000.0,
    "cfl_shrink": 0.5, "max_steps": 16000,
    "max_retries": 14, "stagnation_steps": 64
  },
  "residual": {
    "norm": "l2", "weighting": "volume", "criterion": "either",
    "relative_tolerance": 1e-6, "absolute_tolerance": 1e-9,
    "boundary_tolerance": 1e-9, "global_tolerance": 1e-9,
    "initial_floor": 1e-14
  },
  "execution": {
    "wall_seconds_per_attempt": 600.0,
    "plateau_window": 64,
    "plateau_relative_improvement": 1e-7,
    "plateau_cfl_max": 1e-6,
    "max_parallel_chains": 2,
    "chain_order": ["start", "case", "outlet", "flux", "reconstruction"],
    "compilation_cache": {
      "policy": "study_local_persistent",
      "relative_directory": "jax_cache",
      "minimum_compile_time_seconds": 1.0
    }
  }
}
